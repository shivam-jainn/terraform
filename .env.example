## Terraform shared environment configuration

# GCP project IDs
STAGING_PROJECT_ID=
PRODUCTION_PROJECT_ID=

# Default region for networking resources
TF_VAR_region=us-central1

# Example networking defaults (can be overridden per-environment via tfvars)
TF_VAR_vpc_name=
TF_VAR_router_name=

# Authentication (if not using Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

